# Скапіруйце гэты файл у .env і запоўніце пад сваю ўстаноўку.
# .env не трапляе ў git (гл. .gitignore). Пераменныя асяроддзя маюць
# прыярытэт над значэннямі з .env.

# Падключэнне да PostgreSQL
DENDROBASE_DB_HOST=localhost
DENDROBASE_DB_PORT=5432
DENDROBASE_DB_NAME=postgres
DENDROBASE_DB_USER=postgres
DENDROBASE_DB_PASSWORD=

# Логі: DEBUG | INFO | WARNING | ERROR
DENDROBASE_LOG_LEVEL=INFO
# Папка для файлаў логаў. Калі пуста, выкарыстоўваецца стандартная папка АС:
#   Windows: %LOCALAPPDATA%\DendroBASE\logs
#   macOS:   ~/Library/Logs/DendroBASE
#   Linux:   ~/.local/state/dendrobase/logs
DENDROBASE_LOG_DIR=

# Папка з Excel-файламі для скрыпта імпарту (python -m dendrobase.excel_import).
# Адносны шлях лічыцца ад кораня праекта, напрыклад: DENDROBASE_EXCEL_FOLDER=Chronologies
DENDROBASE_EXCEL_FOLDER=
